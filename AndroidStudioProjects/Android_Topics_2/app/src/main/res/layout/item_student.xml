<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="20dp"
    android:background="#EB9BEB"
    android:layout_marginTop="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <ImageView
        android:id="@+id/blockIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="10dp"/>



    <TextView
        android:id="@+id/studentNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="student name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="normal"/>

    <TextView
        android:id="@+id/studentIdTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="student id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studentNameTv"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="normal"/>


    <TextView
        android:id="@+id/studentGbaTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="student gba"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studentIdTv"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="normal"/>






</androidx.constraintlayout.widget.ConstraintLayout>